# Copie para .env.production no servidor e preencha.
# Nunca versione segredos reais.

NODE_ENV=production
NEXTAUTH_URL=https://srv1655483.hstgr.cloud
NEXTAUTH_SECRET=gere_um_secret_forte

# Supabase
# Runtime da aplicação: transaction pooler (PgBouncer) na 6543.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Prisma migrate/status: sessão direta no pooler da 5432 (evita dependência de IPv6 no host db.<ref>.supabase.co).
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# Resend
RESEND_API_KEY=re_xxx
# Ajuste quando tiver domínio de e-mail verificado no Resend
RESEND_FROM_EMAIL=noreply@srv1655483.hstgr.cloud

# Asaas
ASAAS_ENV=production
ASAAS_API_KEY=\$aact_xxx
ASAAS_WALLET_ID=
ASAAS_WEBHOOK_TOKEN=whsec_xxx

# Due diligence — Escavador (consulta manual no admin; cole o token quando tiver)
ESCAVADOR_BASE_URL=https://api.escavador.com
ESCAVADOR_API_TOKEN=

# Serasa: via Asaas (mesma ASAAS_API_KEY). Ative "Consulta Serasa Experian via API" no Asaas.

# Provedor SSL (acme companion)
# E-mail válido para registro Let's Encrypt (pode ser o seu pessoal)
LETSENCRYPT_EMAIL=seu-email@exemplo.com
